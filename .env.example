# Copia este archivo como .env y completa las credenciales de forma local.
# Nunca coloques estas claves en frontend/app.js ni las publiques.
# NetAssist intenta primero Gemini y usa Groq como respaldo.
# Verifica los nombres de modelo vigentes en aistudio.google.com y console.groq.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# URL exacta desde la que se servirá frontend/ (por defecto, servidor HTTP local).
FRONTEND_ORIGIN=http://localhost:5500

# Información visible para derivación humana; reemplázala por el contacto real.
SUPPORT_CONTACT=Docente de laboratorio: soporte@ejemplo.edu | Extensión 1234

# El modelo se descarga la primera vez que se inicia el backend.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Número máximo de fragmentos recuperados y distancia coseno máxima aceptada.
RAG_TOP_K=4
RAG_DISTANCE_THRESHOLD=0.65
